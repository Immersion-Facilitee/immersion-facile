{
  "$schema": "https://turborepo.org/schema.json",
  "globalPassThroughEnv": ["SSH_AUTH_SOCK"],
  "tasks": {
    "includecheck": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/.biome.grit.rules/**"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:no-typecheck": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "verify-migrations-order": {
      "cache": false
    },
    "test": {
      "dependsOn": ["typecheck"],
      "outputs": []
    }
  }
}
