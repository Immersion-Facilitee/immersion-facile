{
  "$schema": "https://turborepo.org/schema.json",
  "globalPassThroughEnv": ["SSH_AUTH_SOCK"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "includecheck": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:no-typecheck": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "verify-migrations-order": {
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
