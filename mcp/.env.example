# HTTP port for the MCP server
PORT=3000

# API token for Immersion Facilitée public API (authorization header)
# Request a key from the Immersion Facilitée team for the "recherche d'entreprise" scope.
# Docs: https://immersion-facile.beta.gouv.fr/doc-api?version=v3
IMMERSION_FACILE_API_TOKEN=

# Optional override of the API base URL (default: production)
# IMMERSION_FACILE_API_BASE_URL=https://immersion-facile.beta.gouv.fr/api

# Optional override of the front base URL used for offer links
# IMMERSION_FACILE_FRONT_BASE_URL=https://immersion-facile.beta.gouv.fr
