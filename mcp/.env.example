# HTTP bind address (default: loopback only — do not expose without auth)
HOST=127.0.0.1

# HTTP port for the MCP server (avoid 3000 — used by the front)
PORT=3100

# Same DOMAIN as the monorepo (.env.sample / back). Used to build front and API base URLs.
# Examples: localhost:3000 | immersion-facile.beta.gouv.fr
DOMAIN=localhost:3000

# API token for Immersion Facilitée public API (authorization header)
# Request a key from the Immersion Facilitée team for the "recherche d'entreprise" scope.
# Docs: https://immersion-facile.beta.gouv.fr/doc-api?version=v3
IMMERSION_FACILE_API_TOKEN=
