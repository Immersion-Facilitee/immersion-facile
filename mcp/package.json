{
  "name": "mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Immersion Facilitée",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm -w check:glob ./mcp/src",
    "fullcheck": "pnpm -w fullcheck --filter=mcp",
    "zip:skill": "rm -f skill/dist/skill.zip && mkdir -p skill/dist && cd skill && zip -r ./dist/skill.zip . -x '*.DS_Store' -x 'dist/*'"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "axios": "^1.20.0",
    "shared": "workspace:*",
    "shared-routes": "^0.10.10",
    "ts-pattern": "^5.7.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
