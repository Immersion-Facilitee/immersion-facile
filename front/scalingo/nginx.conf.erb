# --- CRLF protection and header injection protection (cf. https://blog.devsecopsguides.com/p/attacking-nginx) ---
if ($request_uri ~* "%0d|%0a|\r|\n") {
  return 400 "Bad Request - CRLF detected in URI";
}
if ($query_string ~* "%0d|%0a|\r|\n") {
  return 400 "Bad Request - CRLF detected in query string";
}

if ($http_user_agent ~* "%0d|%0a|\r|\n") {
  return 400 "Bad Request - Invalid header";
}

set $csp_script_src_hosts "'unsafe-eval' https://client.crisp.chat https://cdn.tagcommander.com https://tag.aticdn.net https://tally.so";
set $csp_other_directives "connect-src 'self' data: https://sentry.gip-inclusion.cloud-ed.fr https://*.ingest.de.sentry.io https://client.crisp.chat wss://client.relay.crisp.chat https://hd.pe.fr; style-src 'self' 'unsafe-inline' https://client.crisp.chat; frame-src 'self' https://metabase.immersion-facile.beta.gouv.fr https://metabase-v2.immersion-facile.beta.gouv.fr https://tally.so; font-src 'self' https://client.crisp.chat; img-src 'self' data: blob: https://user-images.githubusercontent.com https://*.openstreetmap.org https://immersion.cellar-c2.services.clever-cloud.com https://immersion-dev.cellar-c2.services.clever-cloud.com https://immersion-staging.cellar-c2.services.clever-cloud.com; media-src 'self' https://immersion.cellar-c2.services.clever-cloud.com https://immersion-dev.cellar-c2.services.clever-cloud.com https://immersion-staging.cellar-c2.services.clever-cloud.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self';";
set $csp_list "default-src 'self'; script-src 'self' $csp_script_src_hosts; $csp_other_directives";
set $csp_convention_form_frame_ancestors "'self' https://*.cci.fr https://campuscci.fr https://www.campuscci.fr https://cci10.fr https://www.cci-paris-idf.fr https://www.ccicharente-formation.fr https://www.cciformation49.fr https://www.cciformation53.fr https://www.ccinordisere.fr https://cma-nouvelleaquitaine.fr https://*.cma-nouvelleaquitaine.fr https://cma-formation-paysdelaloire.fr https://*.cma-occitanie.fr https://www.cma-alsace-moselle-grandest.fr https://www.cma-hautsdefrance.fr https://*.pole-emploi.intra https://*.francetravail.intra https://*.francetravail.net";
set $csp_report_only_list "default-src 'self'; script-src 'self' $csp_script_src_hosts; $csp_other_directives report-uri https://o4510900710146048.ingest.de.sentry.io/api/4511375917908048/security/?sentry_key=5800b3725ecb4a0cb8461afdb7f2374f&sentry_environment=<%= ENV['VITE_ENV_TYPE'] %>;";

location ~* ^/($|index\.html) {
  root /app/dist;

  add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
  add_header Pragma "no-cache" always;
  add_header Expires "0" always;

  add_header Content-Security-Policy "$csp_list frame-ancestors 'self';" always;
  add_header Content-Security-Policy-Report-Only "$csp_report_only_list frame-ancestors 'self';" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-XSS-Protection "1; mode=block" always;

  try_files $uri /index.html;
}

location / {
  root /app/dist;

  add_header Content-Security-Policy "$csp_list frame-ancestors 'self';" always;
  add_header Content-Security-Policy-Report-Only "$csp_report_only_list frame-ancestors 'self';" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-XSS-Protection "1; mode=block" always;

  try_files $uri /index.html;
}

location ~ ^/demande-(immersion|mini-stage)(/|$) {
  root /app/dist;

  add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
  add_header Pragma "no-cache" always;
  add_header Expires "0" always;

  add_header Content-Security-Policy "$csp_list frame-ancestors $csp_convention_form_frame_ancestors;" always;
  add_header Content-Security-Policy-Report-Only "$csp_report_only_list frame-ancestors $csp_convention_form_frame_ancestors;" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-XSS-Protection "1; mode=block" always;

  try_files /index.html =404;
}

location /api {
  rewrite /api/(.*) /$1 break;
  real_ip_header X-Forwarded-For;
  proxy_pass https://<%= ENV['APP'].gsub("front", "back") %>.<%= ENV['REGION_NAME'] %>.scalingo.io;
  proxy_buffer_size 16k;
  proxy_busy_buffers_size 16k;
}

location /aide {
    proxy_pass https://immersion-facilitee.crisp.help/fr;
    proxy_http_version 1.1;

    proxy_ssl_server_name on;

    proxy_set_header Accept-Encoding "";
    proxy_set_header Access-Control-Allow-Origin "*";
}

location = /etablissement {
    return 301 $scheme://$http_host/accueil-entreprises;
}

location = /recherche-diagoriente {
    return 301 $scheme://$http_host/recherche;
}

location ~ ^/tableau-de-bord-beneficiaire(.*)$ {
    return 301 $scheme://$http_host/mon-compte/tableau-de-bord-beneficiaire$1$is_args$args;
}

location ~ ^/tableau-de-bord-agence(.*)$ {
    return 301 $scheme://$http_host/mon-compte/tableau-de-bord-agence$1$is_args$args;
}

location ~ ^/agence-dashboard(.*)$ {
    return 301 $scheme://$http_host/mon-compte/tableau-de-bord-agence$1$is_args$args;
}

location ~ ^/tableau-de-bord-etablissement(.*)$ {
    return 301 $scheme://$http_host/mon-compte/tableau-de-bord-etablissement$1$is_args$args;
}

location ~ ^/mon-profil(.*)$ {
    return 301 $scheme://$http_host/mon-compte$1$is_args$args;
}

location ~ ^/groupe/groupe-ravate(.*)$ {
    return 301 $scheme://$http_host/groupe/ravate$1$is_args$args;
}

