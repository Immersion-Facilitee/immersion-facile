// Source rule : https://github.com/sindresorhus/eslint-plugin-unicorn/blob/main/docs/rules/prefer-short-arrow-method.md

engine biome(1.0)
language js(typescript, jsx)

JsMethodObjectMember(
  name = $name,
  parameters = $params,
  body = JsFunctionBody(statements = [JsReturnStatement(argument = $expr)])
) as $method where {
  $expr <: r".+",
  $method <: not r"(?s)\*.*",
  $name <: not `__proto__`,
  $name <: not `"__proto__"`,
  $name <: not `'__proto__'`,
  $method <: not contains TsThisParameter(),
  $method <: not contains `this`,
  $method <: not contains `super`,
  $method <: not contains `arguments`,
  $method <: not contains `new.target`,
  $method <: not contains `eval(`,
  $method <: not contains TsTypeParameters(),
  $method <: not contains TsReturnTypeAnnotation(),

  register_diagnostic(
    span = $method,
    message = "Prefer an arrow function property over a method with a single return.",
    severity = "error",
    fix_kind = "safe"
  ),

  if ($expr <: or {
    `{ $... }`,
    `$x as $t`,
    `$x satisfies $t`,
    JsSequenceExpression()
  }) {
    $wrapped = `($expr)`
  } else {
    $wrapped = $expr
  },

  if ($method <: r"(?s)async.*") {
    $method => `$name: async $params => $wrapped`
  } else {
    $method => `$name: $params => $wrapped`
  }
}
