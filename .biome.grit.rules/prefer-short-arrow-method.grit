// Source rule : https://github.com/sindresorhus/eslint-plugin-unicorn/blob/main/docs/rules/prefer-short-arrow-method.md

language js(typescript, jsx);

JsMethodObjectMember(
  name = $name,
  parameters = $params,
  body = $body
) as $method where {

  $name <: not `__proto__`,
  $method <: not contains `*`,

  $body <: `{ return $expr; }`,
  $expr <: not ``,

  $params <: not contains `this`,
  $body <: not contains `this`,
  $body <: not contains `super`,
  $body <: not contains `arguments`,

  register_diagnostic(
    span = $method,
    message = "Prefer an arrow function property over a method with a single return.",
    severity = "error",
    fix_kind = "safe"
  ),

  if ($expr <: or { `{ $... }`, `$x as $t`, `$x satisfies $t` }) {
    $wrapped = `($expr)`
  } else {
    $wrapped = $expr
  },

  if ($method <: contains `async`) {
    $method => `$name: async $params => $wrapped`
  } else {
    $method => `$name: $params => $wrapped`
  }
}